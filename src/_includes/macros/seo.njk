{% macro tags(pageTitle, pageDesc, pageImage) %}
  {# Spaces are not valid in URLs; encode them until filenames are normalized. #}
  {% set imgPath = ((pageImage or site.logo) | url) | replace(" ", "%20") %}
  {% set pageAbs = site.url + (page.url | replace(" ", "%20")) %}

  <title>{{ pageTitle | safe }}</title>
  <meta name="description" content="{{ pageDesc | striptags | truncate(160, true, '') }}">
  <link rel="canonical" href="{{ pageAbs }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc | striptags | truncate(200, true, '') }}">
  <meta property="og:url" content="{{ pageAbs }}">
  <meta property="og:image" content="{{ site.url }}{{ imgPath }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc | striptags | truncate(200, true, '') }}">
  <meta name="twitter:image" content="{{ site.url }}{{ imgPath }}">

  {# One organization entity site-wide: every page resolves to the same @id.
     streetAddress intentionally absent until the owner supplies it. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "{{ site.url }}/#website",
    "url": "{{ site.url }}/",
    "name": "{{ site.name }}",
    "inLanguage": "{{ site.lang }}",
    "publisher": { "@id": "{{ site.url }}/#organization" }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "RealEstateAgent",
    "@id": "{{ site.url }}/#organization",
    "name": "{{ site.brand or site.name }}",
    "legalName": "{{ site.legalName }}",
    "url": "{{ site.url }}/",
    "logo": "{{ site.url }}{{ (site.logo | url) | replace(" ", "%20") }}",
    "telephone": ["{{ site.phone }}", "{{ site.phone2 }}"],
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Santo Domingo",
      "addressRegion": "Distrito Nacional",
      "addressCountry": "DO"
    },
    "areaServed": [
      { "@type": "Place", "name": "Santo Domingo" },
      { "@type": "Place", "name": "Distrito Nacional" },
      { "@type": "Place", "name": "Punta Cana" },
      { "@type": "Place", "name": "Juan Dolio" }
    ],
    "sameAs": [
      "{{ site.social.instagram }}",
      "{{ site.social.facebook }}",
      "{{ site.social.corotos }}"
    ]
  }
  </script>
{% endmacro %}




