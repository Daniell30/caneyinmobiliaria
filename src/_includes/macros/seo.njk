{# src/_includes/macros/seo.njk #}
{% macro tags(pageTitle, pageDesc, pageImage) %}
  {% set title = (pageTitle | default('')) | safe %}
  {% set desc = (pageDesc | default('') | striptags | truncate(160, true, '')) %}
  {% set canonical = (site.url | default('')) ~ (page.url | default('')) %}
  {% set ogimg = pageImage
      ? ( (site.url | default('')) ~ (pageImage | url) )
      : ( (site.url | default('')) ~ (site.logo | url) ) %}

  <title>{{ title }}</title>
  <meta name="description" content="{{ desc }}">
  <link rel="canonical" href="{{ canonical }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogimg }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ desc }}">
  <meta name="twitter:image" content="{{ ogimg }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "RealEstateAgent",
    "name": "{{ site.brand | default(site.name) }}",
    "url": "{{ site.url | default('') }}",
    "logo": "{{ (site.url | default('')) ~ (site.logo | url) }}",
    "telephone": "{{ site.phone | default('') }}"
  }
  </script>
{% endmacro %}


