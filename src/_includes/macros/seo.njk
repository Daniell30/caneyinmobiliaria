{% macro tags(pageTitle, pageDesc, pageImage) %}
  {# Spaces are not valid in URLs; encode them until filenames are normalized. #}
  {% set imgPath = ((pageImage or site.logo) | url) | replace(" ", "%20") %}
  {% set pageAbs = site.url + (page.url | replace(" ", "%20")) %}

  <title>{{ pageTitle | safe }}</title>
  <meta name="description" content="{{ pageDesc | striptags | truncate(160, true, '') }}">
  <link rel="canonical" href="{{ pageAbs }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc | striptags | truncate(200, true, '') }}">
  <meta property="og:url" content="{{ pageAbs }}">
  <meta property="og:image" content="{{ site.url }}{{ imgPath }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc | striptags | truncate(200, true, '') }}">
  <meta name="twitter:image" content="{{ site.url }}{{ imgPath }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "RealEstateAgent",
    "name": "{{ site.brand or site.name }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}{{ site.logo | url }}",
    "telephone": "{{ site.phone }}"{% if site.social and site.social.instagram %},
    "sameAs": ["{{ site.social.instagram }}"]{% endif %}
  }
  </script>
{% endmacro %}




