{# src/_includes/macros/slideHref.njk #}
{% macro slideHref(s, properties) -%}
  {% if s.href %}
    {{- s.href -}}
  {% elif s.refFilename %}
    {# find property by refFilename and use its fixed slug, like property.11ty.js #}
    {%- set url = '' -%}
    {%- for item in properties -%}
      {%- if item.filename == s.refFilename -%}
        {%- set url = '/' ~ item.slug -%}
      {%- endif -%}
    {%- endfor -%}
    {{- url or '#' -}}
  {% else %}
    #
  {% endif %}
{%- endmacro %}
