{# src/_includes/layouts/base.njk #}
<!doctype html>
<html lang="{{ site.lang | default('es-DO') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# Import SEO macro and emit SEO tags #}
  {% from "macros/seo.njk" import tags as seo %}
  {{ seo(pageTitle or title or site.name, pageDesc or '', pageImage or site.logo, page) }}

  {# Page-specific CSS (IMPORTANT: exact key name is pageCSS) #}
  {% if pageCSS %}
    <link rel="stylesheet" href="{{ pageCSS }}">
  {% else %}
    <link rel="stylesheet" href="/CSS/Caneyvisual.css">
  {% endif %}
</head>
<body>
  {{ content | safe }}
</body>
</html>
