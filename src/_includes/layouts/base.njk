<!doctype html>
<html lang="{{ site.lang | default('es-DO') }}">
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-17897616535"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-17897616535');
</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="EAe0uIdP1PeWUzNKg97Sfa3jm82P7OulSVRGBwDt1CQ" />

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  {# "with context" is required: without it the macro cannot see the `site`
     and `page` globals, and canonical/og:url/JSON-LD render empty. #}
  {% from "macros/seo.njk" import tags as seo with context %}
  {{ seo(pageTitle or title or site.name, pageDesc, pageImage) }}

  <link rel="stylesheet" href="{{ '/css/caneyvisual.css' | url }}">

  {# Support BOTH pageCss and pageCSS so casing never bites us again #}
  {% set pageStyle = pageCss or pageCSS %}
  {% if pageStyle %}
    <link rel="stylesheet" href="{{ pageStyle | url }}">
  {% endif %}
</head>
<body>
  {{ content | safe }}
</body>
</html>



